# Bracket imports (/api/import). Copy to .env.local for `npm run dev`; set the same names in Vercel.
STARTGG_TOKEN=
# Challonge API v2.1 app (Developer Portal: connect.challonge.com)
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
# Optional: legacy account API key, used only if the client ID/secret aren't set
CHALLONGE_API_KEY=
