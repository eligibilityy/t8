# Bracket imports (/api/import). Copy to .env.local for `npm run dev`; set the same names in Vercel.
STARTGG_TOKEN=
# Challonge account API key: needed to read other organisers' public brackets (API v1)
CHALLONGE_API_KEY=
# Optional Challonge API v2.1 app (connect.challonge.com): brackets on your own account
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
